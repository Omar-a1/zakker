PORT=3000

# رابط الاتصال بقاعدة بيانات MongoDB Atlas
MONGO_URI="mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/zakker?retryWrites=true&w=majority"

# مفاتيح VAPID لإشعارات المتصفح
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_EMAIL="mailto:your-email@example.com"

# إعدادات Upstash QStash لإيقاظ السيرفر وإرسال التنبيهات مع Retries
QSTASH_URL="https://qstash-eu-central-1.upstash.io"
QSTASH_TOKEN=""
QSTASH_CURRENT_SIGNING_KEY=""
QSTASH_NEXT_SIGNING_KEY=""
APP_URL="https://your-app.vercel.app"
QSTASH_RETRIES=3
