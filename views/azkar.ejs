        <% }); %>
      </div>
    </section>

    <!-- 5. أذكار الوضوء -->
    <section class="daily-category-section" id="section-wudu">
      <div class="daily-category-header">
        <div class="daily-cat-title-group">
          <span class="daily-cat-icon">💧</span>
          <h2>خامساً: أذكار الوضوء</h2>
        </div>
      </div>
      <div class="azkar-list">
        <% azkar.wudu.forEach(function(item) { %>
