<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main class="container page-content">
  <div class="page-header">
    <h1>جميع الأذكار 📿</h1>
    <p>الأذكار النبوية الصحيحة في سائر الأحوال: الاستيقاظ، النوم، دخول وخروج المنزل، الخلاء، والوضوء</p>

    <!-- شريط التحكم بحجم الخط لجميع الأذكار -->
    <div class="font-controls-bar">
      <span class="font-controls-label">حجم الخط:</span>
      <div class="font-btn-group">
        <button type="button" id="font-plus" class="btn-font" title="تكبير الخط">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
          <span>تكبير</span>
        </button>
        <button type="button" id="font-reset" class="btn-font" title="استعادة الحجم الافتراضي">
          <span>افتراضي</span>
        </button>
        <button type="button" id="font-minus" class="btn-font" title="تصغير الخط">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line></svg>
          <span>تصغير</span>
        </button>
      </div>
    </div>

    <!-- أزرار التنقل السريع بين أقسام الأذكار -->
    <div class="category-tabs-bar">
      <a href="#section-waking" class="category-tab">أذكار الاستيقاظ ☀️</a>
      <a href="#section-sleep" class="category-tab">أذكار النوم 🌙</a>
      <a href="#section-home" class="category-tab">أذكار المنزل 🏡</a>
      <a href="#section-restroom" class="category-tab">أذكار الخلاء 🚪</a>
      <a href="#section-wudu" class="category-tab">أذكار الوضوء 💧</a>
    </div>
  </div>

  <div class="daily-sections-wrapper">
    <!-- 1. أذكار الاستيقاظ من النوم -->
    <section class="daily-category-section" id="section-waking">
      <div class="daily-category-header">
        <div class="daily-cat-title-group">
          <span class="daily-cat-icon">☀️</span>
          <h2>أولاً: أذكار الاستيقاظ من النوم</h2>
        </div>
      </div>
      <div class="azkar-list">
        <% azkar.waking.forEach(function(item) { %>
          <article class="zekr-card" id="zekr-waking-<%= item.id %>">
            <div class="zekr-body">
              <% if (item.name) { %>
                <div class="zekr-header-meta">
                  <h3 class="zekr-title"><%= item.name %></h3>
                  <span class="zekr-badge"><%= item.category %></span>
                </div>
              <% } %>
              <p class="zekr-text"><%= item.text %></p>
              <% if (item.virtue) { %><div class="zekr-fadl"><%= item.virtue %></div><% } %>
            </div>
            <div class="zekr-footer">
              <span class="zekr-target">التكرار: <strong><%= item.count %></strong></span>
              <button class="zekr-counter-btn" data-target="<%= item.count %>" data-current="0">
                <span class="count-num">0</span> / <%= item.count %>
              </button>
            </div>
          </article>
        <% }); %>
      </div>
    </section>

    <!-- 2. أذكار النوم -->
