<!-- سكريبت التمرير السلس الذكي بدون أي تعارض -->
<script>
  (function() {
    const tabs = document.querySelectorAll('.category-tab');
    const sections = document.querySelectorAll('.daily-category-section');
    const bar = document.querySelector('.category-tabs-bar');
    let isClickScrolling = false;
    let scrollTimeout = null;

    // حساب الارتفاع الحقيقي للـ Navbar وضبطه ديناميكياً
    function updateHeaderOffset() {
      const header = document.querySelector('.main-header');
      if (header) {
        const h = Math.round(header.getBoundingClientRect().height);
        document.documentElement.style.setProperty('--header-height', h + 'px');
      }
    }
    updateHeaderOffset();
    window.addEventListener('resize', updateHeaderOffset);

    // محاذاة التبويب النشط أفقياً داخل الشريط دون التأثير على الصفحة
    function centerTabInBar(tab) {
      if (!bar || !tab) return;
      const tabLeft = tab.offsetLeft;
      const tabWidth = tab.offsetWidth;
      const barWidth = bar.clientWidth;
      const targetScroll = tabLeft - (barWidth / 2) + (tabWidth / 2);

      bar.scrollTo({
        left: targetScroll,
        behavior: 'smooth'
      });
    }

    // التمرير السلس للقسم عند النقر
    tabs.forEach(tab => {
      tab.addEventListener('click', function(e) {
        const targetId = this.getAttribute('data-target') || (this.getAttribute('href') || '').replace('#', '');
        const targetSection = document.getElementById(targetId);

        if (targetSection) {
          e.preventDefault();
          isClickScrolling = true;

          // تحديث التبويب النشط
          tabs.forEach(t => t.classList.remove('active'));
          this.classList.add('active');
          centerTabInBar(this);

          // التمرير السلس المعتمد على scroll-margin-top
          targetSection.scrollIntoView({
            behavior: 'smooth',
            block: 'start'
          });

          if (scrollTimeout) clearTimeout(scrollTimeout);
          scrollTimeout = setTimeout(() => {
            isClickScrolling = false;
          }, 850);
        }
      });
    });

    // تحديث التبويب النشط عند التمرير الطبيعي بالماوس أو اللمس
    function onWindowScroll() {
      if (isClickScrolling || sections.length === 0) return;

      const header = document.querySelector('.main-header');
      const headerH = header ? header.getBoundingClientRect().height : 104;
      const navOffset = headerH + 75;
      const scrollPos = window.pageYOffset || document.documentElement.scrollTop || 0;

      let currentId = '';
      sections.forEach(sec => {
        const top = sec.offsetTop - navOffset;
        const height = sec.offsetHeight;
        if (scrollPos >= top && scrollPos < top + height) {
          currentId = sec.id;
        }
      });

      if (currentId) {
        tabs.forEach(t => {
          const tId = t.getAttribute('data-target') || (t.getAttribute('href') || '').replace('#', '');
          if (tId === currentId) {
            if (!t.classList.contains('active')) {
              tabs.forEach(x => x.classList.remove('active'));
              t.classList.add('active');
              centerTabInBar(t);
            }
          }
        });
      }
    }

    window.addEventListener('scroll', onWindowScroll, { passive: true });
  })();
</script>

