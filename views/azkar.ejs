    <div class="category-tabs-bar" role="tablist">
      <a href="#section-waking" class="category-tab active" data-target="section-waking">
        <span class="category-tab-icon">☀️</span>
        <span class="category-tab-title">أذكار الاستيقاظ</span>
        <span class="category-tab-badge"><%= azkar.waking.length %></span>
      </a>
      <a href="#section-sleep" class="category-tab" data-target="section-sleep">
        <span class="category-tab-icon">🌙</span>
        <span class="category-tab-title">أذكار النوم</span>
        <span class="category-tab-badge"><%= azkar.sleep.length %></span>
      </a>
      <a href="#section-home" class="category-tab" data-target="section-home">
        <span class="category-tab-icon">🏡</span>
        <span class="category-tab-title">أذكار المنزل</span>
        <span class="category-tab-badge"><%= azkar.home.length %></span>
      </a>
      <a href="#section-restroom" class="category-tab" data-target="section-restroom">
        <span class="category-tab-icon">🚪</span>
        <span class="category-tab-title">أذكار الخلاء</span>
        <span class="category-tab-badge"><%= azkar.restroom.length %></span>
      </a>
      <a href="#section-wudu" class="category-tab" data-target="section-wudu">
        <span class="category-tab-icon">💧</span>
        <span class="category-tab-title">أذكار الوضوء</span>
        <span class="category-tab-badge"><%= azkar.wudu.length %></span>
      </a>
    </div>
  </nav>

  <div class="daily-sections-wrapper">
    <!-- 1. أذكار الاستيقاظ من النوم -->
    <section class="daily-category-section" id="section-waking">
      <div class="daily-category-header">
        <div class="daily-cat-title-group">
          <span class="daily-cat-icon">☀️</span>
          <h2>أولاً: أذكار الاستيقاظ من النوم</h2>
        </div>
      </div>
      <div class="azkar-list">
        <% azkar.waking.forEach(function(item) { %>
          <article class="zekr-card" id="zekr-waking-<%= item.id %>">
            <div class="zekr-body">
              <% if (item.name) { %>
                <div class="zekr-header-meta">
                  <h3 class="zekr-title"><%= item.name %></h3>
                  <span class="zekr-badge"><%= item.category %></span>
                </div>
              <% } %>
              <p class="zekr-text"><%= item.text %></p>
              <% if (item.virtue) { %><div class="zekr-fadl"><%= item.virtue %></div><% } %>
            </div>
            <div class="zekr-footer">
              <span class="zekr-target">التكرار: <strong><%= item.count %></strong></span>
              <button class="zekr-counter-btn" data-target="<%= item.count %>" data-current="0">
                <span class="count-num">0</span> / <%= item.count %>
              </button>
            </div>
          </article>
        <% }); %>
      </div>
    </section>

