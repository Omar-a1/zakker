  <footer class="main-footer">
    <div class="container">
      <p>© <%= new Date().getFullYear() %> مشروع ذكّر - ألا بذكر الله تطمئن القلوب</p>
    </div>
  </footer>

  <!-- Notification Modal Component -->
  <%- include('notification-modal') %>

  <!-- Reading Progress Bar (شريط تقدم إنجاز الأذكار) -->
  <aside id="reading-progress-bar" class="reading-progress-bar" style="display:none;" aria-label="شريط تقدم الأذكار">
    <div class="reading-progress-container">
      <div class="reading-progress-info">
        <span class="reading-progress-pct" id="reading-progress-pct">0%</span>
        <span class="reading-progress-label" id="reading-progress-label">0 من 0 مكتمل</span>
      </div>
      <div class="reading-progress-track">
        <div class="reading-progress-fill" id="reading-progress-fill" style="width: 0%;"></div>
      </div>
      <div class="reading-progress-controls">
        <button type="button" class="progress-ctrl-btn progress-restore-btn" id="reading-progress-restore" title="الذهاب للذكر التالي">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="7 13 12 18 17 13"></polyline><polyline points="7 6 12 11 17 6"></polyline></svg>
          <span class="restore-text">استكمال</span>
        </button>
        <button type="button" class="progress-ctrl-btn progress-reset-btn" id="reading-progress-reset" title="إعادة تعيين الأذكار للبدء من جديد">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M3 12a9 9 0 0 1 15-6.7L21 8"></path><path d="M21 3v5h-5"></path><path d="M21 12a9 9 0 0 1-15 6.7L3 16"></path><path d="M3 21v-5h5"></path></svg>
        </button>
      </div>
    </div>
  </aside>

  <!-- PWA Offline & Scheduled Notifications Module -->
  <script src="/js/notificationScheduler.js"></script>
  <!-- Main JavaScript File -->
  <script src="/js/main.js?v=3.2"></script>
</body>
</html>
