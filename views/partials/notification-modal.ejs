<!-- مودال التمهيد وإرشادات فك حظر الإشعارات -->
<div id="notifyModalOverlay" class="notify-modal-overlay" style="display: none;" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
  <div class="notify-modal-card">
    <button id="notifyModalCloseBtn" class="notify-modal-close" aria-label="إغلاق">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <!-- الحالة الأولى: تمهيد قبل طلب إذن المتصفح (Soft Prompt) -->
    <div id="notifySoftPromptContent" class="notify-modal-body" style="display: none;">
      <div class="notify-modal-icon pulse-soft">
        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="var(--primary-color)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
          <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
        </svg>
      </div>
      <h3 id="modalTitle" class="notify-modal-title">تفعيل تنبيهات ذكّر في الخلفية</h3>
      <p class="notify-modal-desc">
        احرص على ألا تفوتك أذكار الصباح والمساء ومواعيد الصلوات الخمس. ستصلك التنبيهات في وقتها حتى لو كان الموقع مغلقاً تماماً عبر نظام Web Push.
      </p>
      <div class="notify-modal-features">
        <div class="notify-feature-item">
          <span class="feature-badge">🌅 06:30 ص</span>
          <div class="feature-info">
            <strong>أذكار الصباح</strong>
            <p>تذكير يومي لبدء يومك ببركة وحصن متين.</p>
          </div>
        </div>
        <div class="notify-feature-item">
          <span class="feature-badge">🌇 05:00 م</span>
          <div class="feature-info">
            <strong>أذكار المساء</strong>
            <p>تذكير لحفظ النفس والسكينة حتى تصبح.</p>
          </div>
        </div>
        <div class="notify-feature-item">
          <span class="feature-badge">🕌 الأذان</span>
          <div class="feature-info">
            <strong>الصلوات الخمس</strong>
            <p>إشعار مباشر بدخول وقت كل صلاة من السيرفر.</p>
          </div>
        </div>
      </div>
      <div class="notify-modal-actions">
        <button id="notifySoftConfirmBtn" class="btn-modal-primary">تفعيل واشتراك الآن</button>
        <button id="notifySoftCancelBtn" class="btn-modal-secondary">لاحقاً</button>
      </div>
    </div>

    <!-- الحالة الثانية: التنبيهات مفعلة بالفعل (Active State) -->
    <div id="notifyActiveContent" class="notify-modal-body" style="display: none;">
      <div class="notify-modal-icon pulse-soft">
        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
      </div>
      <h3 class="notify-modal-title">التنبيهات مفعلة بنجاح ✓</h3>
      <p class="notify-modal-desc">
        جهازك متصل بخادم الإشعارات السحابي (Web Push). ستصلك تنبيهات الأذكار والأذان تلقائياً في الخلفية حتى ولو كان المتصفح مغلقاً.
      </p>
      <div class="notify-modal-features">
        <div class="notify-feature-item">
          <span class="feature-badge">مجدول</span>
          <div class="feature-info">
            <strong>أذكار الصباح والمساء والصلوات</strong>
            <p>يعمل السيرفر على مدار الساعة عبر Web Push API لتنبيهك دون الحاجة لفتح الموقع.</p>
          </div>
        </div>
      </div>
      <div class="notify-modal-actions">
        <button id="notifyActiveCloseBtn" class="btn-modal-primary">إغلاق</button>
      </div>
    </div>

    <!-- الحالة الثالثة: إرشادات حل مشكلة الحظر (Unblock Guide) -->
    <div id="notifyBlockedContent" class="notify-modal-body" style="display: none;">
      <div class="notify-modal-icon warning-badge">
        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
        </svg>
      </div>
      <h3 class="notify-modal-title">الإشعارات محظورة في متصفحك</h3>
      <p class="notify-modal-desc">
        قام المتصفح بحظر الإشعارات سابقاً. لإعادة استقبال التنبيهات في الخلفية، يرجى اتباع هذه الخطوات:
      </p>

      <div class="notify-steps-guide">
        <div class="notify-step">
          <span class="step-number">1</span>
          <div class="step-text">
            <strong>اضغط على أيقونة الإعدادات أو القفل</strong>
            <p>بجانب رابط الموقع في شريط العنوان بالأعلى.</p>
          </div>
        </div>

        <div class="notify-step">
          <span class="step-number">2</span>
          <div class="step-text">
            <strong>غيّر الإذن إلى "سماح" (Allow)</strong>
            <p>اختر الإشعارات وحوّلها إلى السماح.</p>
          </div>
        </div>

        <div class="notify-step">
          <span class="step-number">3</span>
          <div class="step-text">
            <strong>تحديث الصفحة</strong>
            <p>اضغط الزر بالأسفل لإعادة تحميل الصفحة وتأكيد التفعيل.</p>
          </div>
        </div>
      </div>

      <div class="notify-modal-actions">
        <button id="notifyReloadBtn" class="btn-modal-primary">تحديث الصفحة الآن</button>
        <button id="notifyBlockedCloseBtn" class="btn-modal-secondary">إغلاق</button>
      </div>
    </div>
  </div>
</div>
