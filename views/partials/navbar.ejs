<header class="main-header">
  <div class="container navbar-content">
    <div class="logo">
      <a href="/" title="موقع ذكّر">
        <span class="logo-text">ذكّر</span>
      </a>
    </div>

    <!-- Desktop Navigation Links -->
    <nav class="nav-links">
      <a href="/" class="<%= currentPage === 'home' ? 'active' : '' %>">الرئيسية</a>
      <a href="/morning" class="<%= currentPage === 'morning' ? 'active' : '' %>">أذكار الصباح</a>
      <a href="/evening" class="<%= currentPage === 'evening' ? 'active' : '' %>">أذكار المساء</a>
      <a href="/prayers" class="<%= currentPage === 'prayers' ? 'active' : '' %>">مواقيت الصلاة</a>
    </nav>

    <!-- Top Action Buttons (Compact Notification & Dark Mode) -->
    <div class="nav-actions">
      <!-- Dark Mode Toggle Button -->
      <button id="themeToggleBtn" class="btn-nav-icon" title="تبديل الوضع الليلي / النهاري" aria-label="تبديل الوضع الليلي">
        <svg class="icon-moon" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
        <svg class="icon-sun" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
      </button>

      <!-- Compact Notification Bell Button -->
      <button id="notifyBtn" class="btn-nav-icon btn-notify-compact" title="تفعيل الإشعارات والتذكير" aria-label="تنبيهات الأذكار والصلاة">
       <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"><path fill-rule="evenodd" clip-rule="evenodd" d="M12 1.25C7.71983 1.25 4.25004 4.71979 4.25004 9V9.7041C4.25004 10.401 4.04375 11.0824 3.65717 11.6622L2.50856 13.3851C1.17547 15.3848 2.19318 18.1028 4.51177 18.7351C5.26738 18.9412 6.02937 19.1155 6.79578 19.2581L6.79768 19.2632C7.56667 21.3151 9.62198 22.75 12 22.75C14.378 22.75 16.4333 21.3151 17.2023 19.2632L17.2042 19.2581C17.9706 19.1155 18.7327 18.9412 19.4883 18.7351C21.8069 18.1028 22.8246 15.3848 21.4915 13.3851L20.3429 11.6622C19.9563 11.0824 19.75 10.401 19.75 9.7041V9C19.75 4.71979 16.2802 1.25 12 1.25ZM15.3764 19.537C13.1335 19.805 10.8664 19.8049 8.62349 19.5369C9.33444 20.5585 10.571 21.25 12 21.25C13.4289 21.25 14.6655 20.5585 15.3764 19.537ZM5.75004 9C5.75004 5.54822 8.54826 2.75 12 2.75C15.4518 2.75 18.25 5.54822 18.25 9V9.7041C18.25 10.6972 18.544 11.668 19.0948 12.4943L20.2434 14.2172C21.0086 15.3649 20.4245 16.925 19.0936 17.288C14.4494 18.5546 9.5507 18.5546 4.90644 17.288C3.57561 16.925 2.99147 15.3649 3.75664 14.2172L4.90524 12.4943C5.45609 11.668 5.75004 10.6972 5.75004 9.7041V9Z" fill="currentColor"/></svg>
      </button>
    </div>
  </div>

  <!-- Mobile Navigation Pill Bar -->
  <div class="mobile-nav-bar">
    <div class="container">
      <nav class="mobile-nav-links">
        <a href="/" class="<%= currentPage === 'home' ? 'active' : '' %>">الرئيسية</a>
        <a href="/morning" class="<%= currentPage === 'morning' ? 'active' : '' %>">أذكار الصباح</a>
        <a href="/evening" class="<%= currentPage === 'evening' ? 'active' : '' %>">أذكار المساء</a>
        <a href="/prayers" class="<%= currentPage === 'prayers' ? 'active' : '' %>">مواقيت الصلاة</a>
      </nav>
    </div>
  </div>
</header>
