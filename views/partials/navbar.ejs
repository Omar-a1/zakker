<header class="main-header">
  <div class="container navbar-content">
    <div class="logo">
      <a href="/" title="موقع ذكّر">
        <span class="logo-text">ذكّر</span>
        <span class="logo-dot"></span>
      </a>
    </div>

    <!-- Desktop Navigation Links -->
    <nav class="nav-links">
      <a href="/" class="<%= currentPage === 'home' ? 'active' : '' %>">الرئيسية</a>
      <a href="/morning" class="<%= currentPage === 'morning' ? 'active' : '' %>">أذكار الصباح</a>
      <a href="/evening" class="<%= currentPage === 'evening' ? 'active' : '' %>">أذكار المساء</a>
      <a href="/prayers" class="<%= currentPage === 'prayers' ? 'active' : '' %>">مواقيت الصلاة</a>
    </nav>

    <!-- Top Action Buttons (Compact Notification & Dark Mode) -->
    <div class="nav-actions">
      <!-- Dark Mode Toggle Button -->
      <button id="themeToggleBtn" class="btn-nav-icon" title="تبديل الوضع الليلي / النهاري" aria-label="تبديل الوضع الليلي">
        <svg class="icon-moon" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
        <svg class="icon-sun" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
      </button>

      <!-- Compact Notification Bell Button -->
      <button id="notifyBtn" class="btn-nav-icon btn-notify-compact" title="تفعيل الإشعارات والتذكير" aria-label="تنبيهات الأذكار والصلاة">
        <svg class="icon-bell" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
          <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
        </svg>
        <span class="notify-status-dot"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Navigation Pill Bar -->
  <div class="mobile-nav-bar">
    <div class="container">
      <nav class="mobile-nav-links">
        <a href="/" class="<%= currentPage === 'home' ? 'active' : '' %>">الرئيسية</a>
        <a href="/morning" class="<%= currentPage === 'morning' ? 'active' : '' %>">أذكار الصباح</a>
        <a href="/evening" class="<%= currentPage === 'evening' ? 'active' : '' %>">أذكار المساء</a>
        <a href="/prayers" class="<%= currentPage === 'prayers' ? 'active' : '' %>">مواقيت الصلاة</a>
      </nav>
    </div>
  </div>
</header>
