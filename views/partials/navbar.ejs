<header class="main-header">
  <div class="container navbar-content">
    <div class="logo">
      <a href="/" title="موقع ذكّر">
        <span class="logo-text">ذكّر</span>
      </a>
    </div>

    <!-- Desktop Navigation Links -->
    <nav class="nav-links">
      <a href="/" class="<%= currentPage === 'home' ? 'active' : '' %>">الرئيسية</a>
      <a href="/morning" class="<%= currentPage === 'morning' ? 'active' : '' %>">أذكار الصباح</a>
      <a href="/evening" class="<%= currentPage === 'evening' ? 'active' : '' %>">أذكار المساء</a>
      <a href="/azkar" class="<%= currentPage === 'azkar' ? 'active' : '' %>">جميع الأذكار</a>
      <a href="/prayers" class="<%= currentPage === 'prayers' ? 'active' : '' %>">مواقيت الصلاة</a>
    </nav>

    <!-- Top Action Buttons (Compact Notification & Dark Mode) -->
    <div class="nav-actions">
      <!-- Dark Mode Toggle Button -->
      <button id="themeToggleBtn" class="btn-nav-icon" title="تبديل الوضع الليلي / النهاري" aria-label="تبديل الوضع الليلي">
        <svg class="icon-moon" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
        <svg class="icon-sun" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
      </button>

      <!-- Compact Notification Bell Button -->
      <button id="notifyBtn" class="btn-nav-icon btn-notify-compact" title="تفعيل الإشعارات والتذكير" aria-label="تنبيهات الأذكار والصلاة">
        <svg class="icon-bell" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
          <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
        </svg>
      </button>

      <!-- Hamburger Menu Toggle Button for Mobile -->
      <button id="burgerBtn" class="btn-nav-icon burger-btn" title="القائمة" aria-label="فتح القائمة" aria-expanded="false" aria-controls="mobileMenuDrawer">
        <span class="burger-bar"></span>
        <span class="burger-bar"></span>
        <span class="burger-bar"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Backdrop & Menu -->
  <div id="mobileMenuBackdrop" class="mobile-menu-backdrop" aria-hidden="true"></div>
  <aside id="mobileMenuDrawer" class="mobile-menu-drawer" aria-hidden="true">
    <div class="mobile-drawer-header">
      <div class="logo">
        <a href="/" title="موقع ذكّر">
          <span class="logo-text">ذكّر</span>
        </a>
      </div>
      <button id="closeDrawerBtn" class="btn-nav-icon close-drawer-btn" title="إغلاق القائمة" aria-label="إغلاق القائمة">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
    <nav class="mobile-drawer-links">
      <a href="/" class="<%= currentPage === 'home' ? 'active' : '' %>">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
          <polyline points="9 22 9 12 15 12 15 22"></polyline>
        </svg>
        <span>الرئيسية</span>
      </a>
      <a href="/morning" class="<%= currentPage === 'morning' ? 'active' : '' %>">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
        <span>أذكار الصباح</span>
      </a>
      <a href="/evening" class="<%= currentPage === 'evening' ? 'active' : '' %>">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
        <span>أذكار المساء</span>
      </a>
      <a href="/azkar" class="<%= currentPage === 'azkar' ? 'active' : '' %>">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
          <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
        </svg>
        <span>جميع الأذكار</span>
      </a>
      <a href="/prayers" class="<%= currentPage === 'prayers' ? 'active' : '' %>">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <polyline points="12 6 12 12 16 14"></polyline>
        </svg>
        <span>مواقيت الصلاة</span>
      </a>
    </nav>
  </aside>
</header>
